generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountKind {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AttemptStatus {
  ACTIVE
  SUBMITTED
  RESET
}

enum OperationalAccountRole {
  BANK
  UNDEPOSITED_FUNDS
  ACCOUNTS_RECEIVABLE
  CREDIT_CARD
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
}

model CaseTemplate {
  id              String             @id @default(uuid()) @db.Uuid
  slug            String             @unique
  title           String
  studentScenario Json               @map("student_scenario")
  instructorData  Json               @map("instructor_data")
  createdAt       DateTime           @default(now()) @map("created_at")
  accounts        TemplateAccount[]
  documents       TemplateDocument[]
  attempts        StudentAttempt[]
  customers       TemplateCustomer[]

  @@map("case_templates")
}

model TemplateCustomer {
  id         String            @id @default(uuid()) @db.Uuid
  templateId String            @map("template_id") @db.Uuid
  name       String
  active     Boolean           @default(true)
  template   CaseTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  customers  AttemptCustomer[]

  @@unique([templateId, id])
  @@map("template_customers")
}

model TemplateAccount {
  id              String           @id @default(uuid()) @db.Uuid
  templateId      String           @map("template_id") @db.Uuid
  code            String
  name            String
  kind            AccountKind
  operationalRole OperationalAccountRole? @map("operational_role")
  template        CaseTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  attemptAccounts AttemptAccount[]

  @@unique([templateId, id])
  @@unique([templateId, code])
  @@map("template_accounts")
}

model TemplateDocument {
  id                String       @id @default(uuid()) @db.Uuid
  templateId        String       @map("template_id") @db.Uuid
  title             String
  studentContent    Json         @map("student_content")
  instructorData    Json         @map("instructor_data")
  unlockAfterAction Int          @map("unlock_after_action")
  template          CaseTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, id])
  @@map("template_documents")
}

model StudentAttempt {
  id         String           @id @default(uuid()) @db.Uuid
  studentId  String           @map("student_id")
  templateId String           @map("template_id") @db.Uuid
  generation Int              @default(1)
  status     AttemptStatus    @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")
  template   CaseTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  accounts   AttemptAccount[]
  entries    JournalEntry[]
  actions    AttemptAction[]
  customers  AttemptCustomer[]
  invoices   Invoice[]
  payments   CustomerPayment[]
  deposits   BankDeposit[]
  reconciliations Reconciliation[]

  @@unique([studentId, templateId, generation])
  @@index([studentId, id])
  @@map("student_attempts")
}

model AttemptCustomer {
  id                       String            @id @default(uuid()) @db.Uuid
  attemptId                String            @map("attempt_id") @db.Uuid
  sourceTemplateCustomerId String?           @map("source_template_customer_id") @db.Uuid
  name                     String
  active                   Boolean           @default(true)
  attempt                  StudentAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  source                   TemplateCustomer? @relation(fields: [sourceTemplateCustomerId], references: [id], onDelete: Restrict)
  invoices                 Invoice[]
  payments                 CustomerPayment[]

  @@unique([attemptId, id])
  @@map("attempt_customers")
}

model AttemptAccount {
  id                      String          @id @default(uuid()) @db.Uuid
  attemptId               String          @map("attempt_id") @db.Uuid
  sourceTemplateAccountId String          @map("source_template_account_id") @db.Uuid
  code                    String
  name                    String
  kind                    AccountKind
  operationalRole         OperationalAccountRole? @map("operational_role")
  attempt                 StudentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  source                  TemplateAccount @relation(fields: [sourceTemplateAccountId], references: [id], onDelete: Restrict)
  lines                   JournalLine[]
  invoiceLines            InvoiceLine[]
  invoiceAr               Invoice[]       @relation("InvoiceArAccount")
  paymentDestinations     CustomerPayment[] @relation("PaymentDestination")
  paymentAr               CustomerPayment[] @relation("PaymentArAccount")
  depositBanks            BankDeposit[]
  reconciliations         Reconciliation[]

  @@unique([attemptId, id])
  @@unique([attemptId, code])
  @@map("attempt_accounts")
}

model JournalEntry {
  id          String         @id @default(uuid()) @db.Uuid
  attemptId   String         @map("attempt_id") @db.Uuid
  description String
  occurredOn  DateTime       @map("occurred_on") @db.Date
  createdAt   DateTime       @default(now()) @map("created_at")
  attempt     StudentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  lines       JournalLine[]
  sourceType  String?        @map("source_type")
  sourceId    String?        @map("source_id") @db.Uuid
  invoices    Invoice[]
  payments    CustomerPayment[]
  deposits    BankDeposit[]

  @@unique([attemptId, id])
  @@map("journal_entries")
}

model Invoice {
  id              String          @id @default(uuid()) @db.Uuid
  attemptId       String          @map("attempt_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  arAccountId     String          @map("ar_account_id") @db.Uuid
  journalEntryId  String          @map("journal_entry_id") @db.Uuid
  number          String
  invoiceDate     DateTime        @map("invoice_date") @db.Date
  dueDate         DateTime        @map("due_date") @db.Date
  status          InvoiceStatus   @default(OPEN)
  attempt         StudentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  customer        AttemptCustomer @relation(fields: [attemptId, customerId], references: [attemptId, id], onDelete: Restrict)
  arAccount       AttemptAccount  @relation("InvoiceArAccount", fields: [attemptId, arAccountId], references: [attemptId, id], onDelete: Restrict)
  journalEntry    JournalEntry    @relation(fields: [attemptId, journalEntryId], references: [attemptId, id], onDelete: Restrict)
  lines           InvoiceLine[]
  applications    PaymentApplication[]

  @@unique([attemptId, id])
  @@unique([attemptId, number])
  @@map("invoices")
}

model InvoiceLine {
  id               String         @id @default(uuid()) @db.Uuid
  attemptId        String         @map("attempt_id") @db.Uuid
  invoiceId        String         @map("invoice_id") @db.Uuid
  revenueAccountId String         @map("revenue_account_id") @db.Uuid
  description      String
  amountCents      BigInt         @map("amount_cents")
  invoice          Invoice        @relation(fields: [attemptId, invoiceId], references: [attemptId, id], onDelete: Cascade)
  revenueAccount   AttemptAccount @relation(fields: [attemptId, revenueAccountId], references: [attemptId, id], onDelete: Restrict)

  @@map("invoice_lines")
}

model CustomerPayment {
  id                   String          @id @default(uuid()) @db.Uuid
  attemptId            String          @map("attempt_id") @db.Uuid
  customerId           String          @map("customer_id") @db.Uuid
  destinationAccountId String          @map("destination_account_id") @db.Uuid
  arAccountId          String          @map("ar_account_id") @db.Uuid
  journalEntryId       String          @map("journal_entry_id") @db.Uuid
  paymentDate          DateTime        @map("payment_date") @db.Date
  amountCents          BigInt          @map("amount_cents")
  method               String?
  reference            String?
  attempt              StudentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  customer             AttemptCustomer @relation(fields: [attemptId, customerId], references: [attemptId, id], onDelete: Restrict)
  destinationAccount   AttemptAccount  @relation("PaymentDestination", fields: [attemptId, destinationAccountId], references: [attemptId, id], onDelete: Restrict)
  arAccount            AttemptAccount  @relation("PaymentArAccount", fields: [attemptId, arAccountId], references: [attemptId, id], onDelete: Restrict)
  journalEntry         JournalEntry    @relation(fields: [attemptId, journalEntryId], references: [attemptId, id], onDelete: Restrict)
  applications         PaymentApplication[]
  depositLinks         BankDepositPayment[]

  @@unique([attemptId, id])
  @@map("customer_payments")
}

model PaymentApplication {
  id          String          @id @default(uuid()) @db.Uuid
  attemptId   String          @map("attempt_id") @db.Uuid
  paymentId   String          @map("payment_id") @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  amountCents BigInt          @map("amount_cents")
  appliedAt   DateTime        @default(now()) @map("applied_at")
  payment     CustomerPayment @relation(fields: [attemptId, paymentId], references: [attemptId, id], onDelete: Cascade)
  invoice     Invoice         @relation(fields: [attemptId, invoiceId], references: [attemptId, id], onDelete: Cascade)

  @@map("payment_applications")
}

model BankDeposit {
  id             String               @id @default(uuid()) @db.Uuid
  attemptId      String               @map("attempt_id") @db.Uuid
  bankAccountId  String               @map("bank_account_id") @db.Uuid
  journalEntryId String               @map("journal_entry_id") @db.Uuid
  depositDate    DateTime             @map("deposit_date") @db.Date
  amountCents    BigInt               @map("amount_cents")
  attempt        StudentAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  bankAccount    AttemptAccount       @relation(fields: [attemptId, bankAccountId], references: [attemptId, id], onDelete: Restrict)
  journalEntry   JournalEntry         @relation(fields: [attemptId, journalEntryId], references: [attemptId, id], onDelete: Restrict)
  paymentLinks   BankDepositPayment[]

  @@unique([attemptId, id])
  @@map("bank_deposits")
}

model BankDepositPayment {
  depositId String          @map("deposit_id") @db.Uuid
  paymentId String          @map("payment_id") @db.Uuid
  attemptId String          @map("attempt_id") @db.Uuid
  deposit   BankDeposit     @relation(fields: [attemptId, depositId], references: [attemptId, id], onDelete: Cascade)
  payment   CustomerPayment @relation(fields: [attemptId, paymentId], references: [attemptId, id], onDelete: Restrict)

  @@id([attemptId, depositId, paymentId])
  @@unique([attemptId, paymentId])
  @@map("bank_deposit_payments")
}

model Reconciliation {
  id                    String               @id @default(uuid()) @db.Uuid
  attemptId             String               @map("attempt_id") @db.Uuid
  accountId             String               @map("account_id") @db.Uuid
  beginningDate         DateTime             @map("beginning_date") @db.Date
  endingDate            DateTime             @map("ending_date") @db.Date
  beginningBalanceCents BigInt               @map("beginning_balance_cents")
  endingBalanceCents    BigInt               @map("ending_balance_cents")
  status                ReconciliationStatus @default(IN_PROGRESS)
  completedAt           DateTime?            @map("completed_at")
  attempt               StudentAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  account               AttemptAccount       @relation(fields: [attemptId, accountId], references: [attemptId, id], onDelete: Restrict)
  clearedLines          ReconciliationLine[]

  @@unique([attemptId, id])
  @@map("reconciliations")
}

model ReconciliationLine {
  reconciliationId String         @map("reconciliation_id") @db.Uuid
  attemptId        String         @map("attempt_id") @db.Uuid
  journalLineId    String         @map("journal_line_id") @db.Uuid
  fingerprint      String
  reconciliation   Reconciliation @relation(fields: [attemptId, reconciliationId], references: [attemptId, id], onDelete: Cascade)

  @@id([attemptId, reconciliationId, journalLineId])
  @@map("reconciliation_lines")
}

model JournalLine {
  id               String         @id @default(uuid()) @db.Uuid
  entryId          String         @map("entry_id") @db.Uuid
  attemptId        String         @map("attempt_id") @db.Uuid
  attemptAccountId String         @map("attempt_account_id") @db.Uuid
  debitCents       BigInt         @default(0) @map("debit_cents")
  creditCents      BigInt         @default(0) @map("credit_cents")
  entry            JournalEntry   @relation(fields: [attemptId, entryId], references: [attemptId, id], onDelete: Cascade)
  account          AttemptAccount @relation(fields: [attemptId, attemptAccountId], references: [attemptId, id], onDelete: Restrict)

  @@index([entryId])
  @@map("journal_lines")
}

model AttemptAction {
  id        String         @id @default(uuid()) @db.Uuid
  attemptId String         @map("attempt_id") @db.Uuid
  sequence  Int
  kind      String
  detail    Json           @default("{}")
  createdAt DateTime       @default(now()) @map("created_at")
  attempt   StudentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sequence])
  @@map("attempt_actions")
}
