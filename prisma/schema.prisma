generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountKind {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AttemptStatus {
  ACTIVE
  SUBMITTED
  RESET
}

enum OperationalAccountRole {
  BANK
  UNDEPOSITED_FUNDS
  ACCOUNTS_RECEIVABLE
  CREDIT_CARD
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
}

enum RuntimeStudentStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum PreviewInvitationStatus {
  PENDING
  SENT
  CONSUMED
  REVOKED
}

model CaseTemplate {
  id              String             @id @default(uuid()) @db.Uuid
  slug            String             @unique
  title           String
  studentScenario Json               @map("student_scenario")
  instructorData  Json               @map("instructor_data")
  createdAt       DateTime           @default(now()) @map("created_at")
  accounts        TemplateAccount[]
  documents       TemplateDocument[]
  attempts        StudentAttempt[]
  customers       TemplateCustomer[]

  @@map("case_templates")
}

model TemplateCustomer {
  id         String            @id @default(uuid()) @db.Uuid
  templateId String            @map("template_id") @db.Uuid
  name       String
  active     Boolean           @default(true)
  runtimeKey String?           @map("runtime_key")
  template   CaseTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  customers  AttemptCustomer[]

  @@unique([templateId, id])
  @@unique([templateId, runtimeKey])
  @@map("template_customers")
}

model TemplateAccount {
  id              String           @id @default(uuid()) @db.Uuid
  templateId      String           @map("template_id") @db.Uuid
  code            String
  name            String
  kind            AccountKind
  operationalRole OperationalAccountRole? @map("operational_role")
  runtimeKey      String?          @map("runtime_key")
  template        CaseTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  attemptAccounts AttemptAccount[]

  @@unique([templateId, id])
  @@unique([templateId, code])
  @@unique([templateId, runtimeKey])
  @@map("template_accounts")
}

model TemplateDocument {
  id                String       @id @default(uuid()) @db.Uuid
  templateId        String       @map("template_id") @db.Uuid
  title             String
  studentContent    Json         @map("student_content")
  instructorData    Json         @map("instructor_data")
  unlockAfterAction Int          @map("unlock_after_action")
  runtimeKey        String?      @map("runtime_key")
  template          CaseTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, id])
  @@unique([templateId, runtimeKey])
  @@map("template_documents")
}

model StudentAttempt {
  id         String           @id @default(uuid()) @db.Uuid
  studentId  String           @map("student_id")
  templateId String           @map("template_id") @db.Uuid
  generation Int              @default(1)
  status     AttemptStatus    @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")
  template   CaseTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  accounts   AttemptAccount[]
  entries    JournalEntry[]
  actions    AttemptAction[]
  customers  AttemptCustomer[]
  invoices   Invoice[]
  payments   CustomerPayment[]
  applications PaymentApplication[]
  deposits   BankDeposit[]
  reconciliations Reconciliation[]
  runtime     RuntimeAttempt?

  @@unique([studentId, templateId, generation])
  @@index([studentId, id])
  @@map("student_attempts")
}

model AttemptCustomer {
  id                       String            @id @default(uuid()) @db.Uuid
  attemptId                String            @map("attempt_id") @db.Uuid
  sourceTemplateCustomerId String?           @map("source_template_customer_id") @db.Uuid
  name                     String
  active                   Boolean           @default(true)
  runtimeKey               String?           @map("runtime_key")
  attempt                  StudentAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  source                   TemplateCustomer? @relation(fields: [sourceTemplateCustomerId], references: [id], onDelete: Restrict)
  invoices                 Invoice[]
  payments                 CustomerPayment[]

  @@unique([attemptId, id])
  @@unique([attemptId, runtimeKey])
  @@map("attempt_customers")
}

model AttemptAccount {
  id                      String          @id @default(uuid()) @db.Uuid
  attemptId               String          @map("attempt_id") @db.Uuid
  sourceTemplateAccountId String?         @map("source_template_account_id") @db.Uuid
  code                    String
  name                    String
  kind                    AccountKind
  operationalRole         OperationalAccountRole? @map("operational_role")
  runtimeKey              String?         @map("runtime_key")
  attempt                 StudentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  source                  TemplateAccount? @relation(fields: [sourceTemplateAccountId], references: [id], onDelete: Restrict)
  lines                   JournalLine[]
  invoiceLines            InvoiceLine[]
  invoiceAr               Invoice[]       @relation("InvoiceArAccount")
  paymentDestinations     CustomerPayment[] @relation("PaymentDestination")
  paymentAr               CustomerPayment[] @relation("PaymentArAccount")
  depositBanks            BankDeposit[]
  reconciliations         Reconciliation[]

  @@unique([attemptId, id])
  @@unique([attemptId, code])
  @@unique([attemptId, runtimeKey])
  @@map("attempt_accounts")
}

model JournalEntry {
  id          String         @id @default(uuid()) @db.Uuid
  attemptId   String         @map("attempt_id") @db.Uuid
  description String
  occurredOn  DateTime       @map("occurred_on") @db.Date
  createdAt   DateTime       @default(now()) @map("created_at")
  attempt     StudentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  lines       JournalLine[]
  sourceType  String?        @map("source_type")
  sourceId    String?        @map("source_id") @db.Uuid
  runtimeKey  String?        @map("runtime_key")
  runtimeSourceId String?    @map("runtime_source_id")
  invoices    Invoice[]
  payments    CustomerPayment[]
  deposits    BankDeposit[]

  @@unique([attemptId, id])
  @@unique([attemptId, runtimeKey])
  @@map("journal_entries")
}

model Invoice {
  id              String          @id @default(uuid()) @db.Uuid
  attemptId       String          @map("attempt_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  arAccountId     String          @map("ar_account_id") @db.Uuid
  journalEntryId  String          @map("journal_entry_id") @db.Uuid
  number          String
  invoiceDate     DateTime        @map("invoice_date") @db.Date
  dueDate         DateTime        @map("due_date") @db.Date
  status          InvoiceStatus   @default(OPEN)
  runtimeKey      String?         @map("runtime_key")
  attempt         StudentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  customer        AttemptCustomer @relation(fields: [attemptId, customerId], references: [attemptId, id], onDelete: Restrict)
  arAccount       AttemptAccount  @relation("InvoiceArAccount", fields: [attemptId, arAccountId], references: [attemptId, id], onDelete: Restrict)
  journalEntry    JournalEntry    @relation(fields: [attemptId, journalEntryId], references: [attemptId, id], onDelete: Restrict)
  lines           InvoiceLine[]
  applications    PaymentApplication[]

  @@unique([attemptId, id])
  @@unique([attemptId, number])
  @@unique([attemptId, runtimeKey])
  @@map("invoices")
}

model InvoiceLine {
  id               String         @id @default(uuid()) @db.Uuid
  attemptId        String         @map("attempt_id") @db.Uuid
  invoiceId        String         @map("invoice_id") @db.Uuid
  revenueAccountId String         @map("revenue_account_id") @db.Uuid
  description      String
  amountCents      BigInt         @map("amount_cents")
  runtimeKey       String?        @map("runtime_key")
  invoice          Invoice        @relation(fields: [attemptId, invoiceId], references: [attemptId, id], onDelete: Cascade)
  revenueAccount   AttemptAccount @relation(fields: [attemptId, revenueAccountId], references: [attemptId, id], onDelete: Restrict)

  @@unique([attemptId, runtimeKey])
  @@map("invoice_lines")
}

model CustomerPayment {
  id                   String          @id @default(uuid()) @db.Uuid
  attemptId            String          @map("attempt_id") @db.Uuid
  customerId           String          @map("customer_id") @db.Uuid
  destinationAccountId String          @map("destination_account_id") @db.Uuid
  arAccountId          String          @map("ar_account_id") @db.Uuid
  journalEntryId       String          @map("journal_entry_id") @db.Uuid
  paymentDate          DateTime        @map("payment_date") @db.Date
  amountCents          BigInt          @map("amount_cents")
  method               String?
  reference            String?
  runtimeKey           String?         @map("runtime_key")
  attempt              StudentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  customer             AttemptCustomer @relation(fields: [attemptId, customerId], references: [attemptId, id], onDelete: Restrict)
  destinationAccount   AttemptAccount  @relation("PaymentDestination", fields: [attemptId, destinationAccountId], references: [attemptId, id], onDelete: Restrict)
  arAccount            AttemptAccount  @relation("PaymentArAccount", fields: [attemptId, arAccountId], references: [attemptId, id], onDelete: Restrict)
  journalEntry         JournalEntry    @relation(fields: [attemptId, journalEntryId], references: [attemptId, id], onDelete: Restrict)
  applications         PaymentApplication[]
  depositLinks         BankDepositPayment[]

  @@unique([attemptId, id])
  @@unique([attemptId, runtimeKey])
  @@map("customer_payments")
}

model PaymentApplication {
  id          String          @id @default(uuid()) @db.Uuid
  attemptId   String          @map("attempt_id") @db.Uuid
  paymentId   String          @map("payment_id") @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  amountCents BigInt          @map("amount_cents")
  appliedAt   DateTime        @default(now()) @map("applied_at")
  runtimeKey  String?         @map("runtime_key")
  attempt     StudentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  payment     CustomerPayment @relation(fields: [attemptId, paymentId], references: [attemptId, id], onDelete: Cascade)
  invoice     Invoice         @relation(fields: [attemptId, invoiceId], references: [attemptId, id], onDelete: Cascade)

  @@unique([attemptId, runtimeKey])
  @@map("payment_applications")
}

model BankDeposit {
  id             String               @id @default(uuid()) @db.Uuid
  attemptId      String               @map("attempt_id") @db.Uuid
  bankAccountId  String               @map("bank_account_id") @db.Uuid
  journalEntryId String               @map("journal_entry_id") @db.Uuid
  depositDate    DateTime             @map("deposit_date") @db.Date
  amountCents    BigInt               @map("amount_cents")
  runtimeKey     String?              @map("runtime_key")
  attempt        StudentAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  bankAccount    AttemptAccount       @relation(fields: [attemptId, bankAccountId], references: [attemptId, id], onDelete: Restrict)
  journalEntry   JournalEntry         @relation(fields: [attemptId, journalEntryId], references: [attemptId, id], onDelete: Restrict)
  paymentLinks   BankDepositPayment[]

  @@unique([attemptId, id])
  @@unique([attemptId, runtimeKey])
  @@map("bank_deposits")
}

model BankDepositPayment {
  depositId String          @map("deposit_id") @db.Uuid
  paymentId String          @map("payment_id") @db.Uuid
  attemptId String          @map("attempt_id") @db.Uuid
  deposit   BankDeposit     @relation(fields: [attemptId, depositId], references: [attemptId, id], onDelete: Cascade)
  payment   CustomerPayment @relation(fields: [attemptId, paymentId], references: [attemptId, id], onDelete: Restrict)

  @@id([attemptId, depositId, paymentId])
  @@unique([attemptId, paymentId])
  @@map("bank_deposit_payments")
}

model Reconciliation {
  id                    String               @id @default(uuid()) @db.Uuid
  attemptId             String               @map("attempt_id") @db.Uuid
  accountId             String               @map("account_id") @db.Uuid
  beginningDate         DateTime             @map("beginning_date") @db.Date
  endingDate            DateTime             @map("ending_date") @db.Date
  beginningBalanceCents BigInt               @map("beginning_balance_cents")
  endingBalanceCents    BigInt               @map("ending_balance_cents")
  status                ReconciliationStatus @default(IN_PROGRESS)
  completedAt           DateTime?            @map("completed_at")
  runtimeKey            String?              @map("runtime_key")
  attempt               StudentAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  account               AttemptAccount       @relation(fields: [attemptId, accountId], references: [attemptId, id], onDelete: Restrict)
  clearedLines          ReconciliationLine[]
  historicalLines       RuntimeHistoricalReconciliationLine[]

  @@unique([attemptId, id])
  @@unique([attemptId, runtimeKey])
  @@map("reconciliations")
}

model ReconciliationLine {
  reconciliationId String         @map("reconciliation_id") @db.Uuid
  attemptId        String         @map("attempt_id") @db.Uuid
  journalLineId    String         @map("journal_line_id") @db.Uuid
  fingerprint      String
  reconciliation   Reconciliation @relation(fields: [attemptId, reconciliationId], references: [attemptId, id], onDelete: Cascade)

  @@id([attemptId, reconciliationId, journalLineId])
  @@map("reconciliation_lines")
}

model JournalLine {
  id               String         @id @default(uuid()) @db.Uuid
  entryId          String         @map("entry_id") @db.Uuid
  attemptId        String         @map("attempt_id") @db.Uuid
  attemptAccountId String         @map("attempt_account_id") @db.Uuid
  debitCents       BigInt         @default(0) @map("debit_cents")
  creditCents      BigInt         @default(0) @map("credit_cents")
  runtimeKey       String?        @map("runtime_key")
  entry            JournalEntry   @relation(fields: [attemptId, entryId], references: [attemptId, id], onDelete: Cascade)
  account          AttemptAccount @relation(fields: [attemptId, attemptAccountId], references: [attemptId, id], onDelete: Restrict)

  @@index([entryId])
  @@unique([attemptId, runtimeKey])
  @@map("journal_lines")
}

model AttemptAction {
  id        String         @id @default(uuid()) @db.Uuid
  attemptId String         @map("attempt_id") @db.Uuid
  sequence  Int
  kind      String
  detail    Json           @default("{}")
  createdAt DateTime       @default(now()) @map("created_at")
  attempt   StudentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sequence])
  @@map("attempt_actions")
}

model RuntimeHistoricalReconciliationLine {
  id               String         @id @default(uuid()) @db.Uuid
  attemptId        String         @map("attempt_id") @db.Uuid
  reconciliationId String         @map("reconciliation_id") @db.Uuid
  runtimeLineKey   String         @map("runtime_line_key")
  attemptAccountId String         @map("attempt_account_id") @db.Uuid
  debitCents       BigInt         @map("debit_cents")
  creditCents      BigInt         @map("credit_cents")
  fingerprint      String
  reconciliation   Reconciliation @relation(fields: [attemptId, reconciliationId], references: [attemptId, id], onDelete: Cascade)

  @@unique([attemptId, reconciliationId, runtimeLineKey])
  @@map("runtime_historical_reconciliation_lines")
}

model RuntimeStudent {
  id          String           @id
  displayName String           @map("display_name")
  email       String?          @unique
  status      RuntimeStudentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  attempts    RuntimeAttempt[]
  sessions    StudentSession[]
  identities  ExternalIdentityLink[]
  invitations PreviewInvitation[]

  @@map("runtime_students")
}

model ExternalIdentityLink {
  id         String         @id @default(uuid()) @db.Uuid
  studentId  String         @map("student_id")
  provider   String
  subject    String
  email      String?
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  student    RuntimeStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@unique([provider, email])
  @@index([studentId, active])
  @@map("external_identity_links")
}

model PreviewInvitation {
  id                   String                  @id @default(uuid()) @db.Uuid
  studentId            String                  @map("student_id")
  provider             String                  @default("clerk")
  email                String
  providerInvitationId String?                 @unique @map("provider_invitation_id")
  status               PreviewInvitationStatus @default(PENDING)
  consumedSubject      String?                 @map("consumed_subject")
  consumedAt           DateTime?               @map("consumed_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  student              RuntimeStudent          @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([provider, email])
  @@index([studentId, status])
  @@map("preview_invitations")
}

model ProviderWebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  eventType       String   @map("event_type")
  subject         String
  disabled        Boolean  @default(false)
  processedAt     DateTime @default(now()) @map("processed_at")

  @@unique([provider, providerEventId])
  @@index([provider, subject, disabled])
  @@map("provider_webhook_events")
}

model RuntimeAttempt {
  id                 String               @id
  studentId          String               @map("student_id")
  ledgerAttemptId    String               @unique @map("ledger_attempt_id") @db.Uuid
  labVersion         String               @map("lab_version")
  generation         Int
  status             String
  revision           Int                  @default(0)
  persistenceVersion Int                  @default(0) @map("persistence_version")
  accountingDigest   String               @map("accounting_digest")
  p002MetadataState  Json                 @map("p002_metadata_state")
  evidenceState      Json                 @map("evidence_state")
  interactionState   Json                 @map("interaction_state")
  coachingState      Json                 @map("coaching_state")
  assessmentState    Json?                @map("assessment_state")
  meetingState       Json?                @map("meeting_state")
  reportState        Json?                @map("report_state")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  student            RuntimeStudent       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  ledgerAttempt      StudentAttempt       @relation(fields: [ledgerAttemptId], references: [id], onDelete: Restrict)
  idempotency        RuntimeIdempotency[]
  snapshots          RuntimeSnapshot[]
  auditEvents        RuntimeAuditEvent[]

  @@unique([studentId, labVersion, generation])
  @@index([studentId, status, generation])
  @@map("runtime_attempts")
}

model RuntimeAuditEvent {
  id        String         @id @default(uuid()) @db.Uuid
  attemptId String         @map("attempt_id")
  sequence  Int
  payload   Json
  createdAt DateTime       @default(now()) @map("created_at")
  attempt   RuntimeAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([attemptId, sequence])
  @@index([attemptId, sequence])
  @@map("runtime_audit_events")
}

model RuntimeIdempotency {
  id             String         @id @default(uuid()) @db.Uuid
  attemptId      String         @map("attempt_id")
  idempotencyKey String         @map("idempotency_key")
  fingerprint    String
  commandId      String         @map("command_id")
  revision       Int
  createdAt      DateTime       @default(now()) @map("created_at")
  attempt        RuntimeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, idempotencyKey])
  @@index([attemptId, revision])
  @@map("runtime_idempotency")
}

model RuntimeSnapshot {
  id         String         @id @default(uuid()) @db.Uuid
  attemptId  String         @map("attempt_id")
  kind       String
  sequence   Int
  payload    Json
  contentHash String        @map("content_hash")
  createdAt  DateTime       @default(now()) @map("created_at")
  attempt    RuntimeAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([attemptId, kind, sequence])
  @@unique([attemptId, kind, contentHash])
  @@index([attemptId, kind, sequence])
  @@map("runtime_snapshots")
}

model StudentSession {
  id          String         @id @default(uuid()) @db.Uuid
  tokenHash   String         @unique @map("token_hash")
  studentId   String         @map("student_id")
  subject     String
  displayName String         @map("display_name")
  expiresAt   DateTime       @map("expires_at")
  revokedAt   DateTime?      @map("revoked_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  student     RuntimeStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("student_sessions")
}

model CanonicalLabBootstrap {
  labId           String   @map("lab_id")
  version         String
  contentHash     String   @map("content_hash")
  contentManifest Json     @map("content_manifest")
  databaseDigest  String   @map("database_digest")
  installedAt     DateTime @default(now()) @map("installed_at")
  verifiedAt      DateTime @default(now()) @map("verified_at")

  @@id([labId, version])
  @@map("canonical_lab_bootstrap")
}
