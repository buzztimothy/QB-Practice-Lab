# Preview contract. Values marked <secret> belong only in the owner named by D002B-PROVISIONING.md.
NODE_ENV=production
NODE_VERSION=22.18.0
DEPLOYMENT_TARGET=preview
DURABLE_RUNTIME_ENABLED=true
LOCAL_AUTH_ENABLED=false
APP_ORIGIN=https://preview.clientpracticelabs.com
CANONICAL_LAB_VERSION=<merged-canonical-version>
SESSION_TTL_SECONDS=28800
DATABASE_URL=<render-pooled-runtime-secret>
CLERK_PUBLISHABLE_KEY=<render-config-value>
CLERK_SECRET_KEY=<render-secret>
CLERK_JWT_KEY=<render-config-value>
CLERK_ISSUER=<render-config-value>
CLERK_AUDIENCE=<render-config-value>
CLERK_AUTHORIZED_PARTY=https://preview.clientpracticelabs.com
CLERK_SIGN_IN_URL=<render-config-value>
CLERK_WEBHOOK_SIGNING_SECRET=<render-secret>

# Protected GitHub environment only; never configure on Render.
DIRECT_DATABASE_URL=<github-environment-deploy-secret>
PREVIEW_DATABASE_CONFIRMATION=bbb_practice_preview
PREVIEW_DATABASE_HOST=<exact-neon-direct-hostname>
RENDER_DEPLOY_HOOK_URL=<github-environment-secret>
PREVIEW_ORIGIN=https://preview.clientpracticelabs.com
