{
  "name": "qb-practice-lab",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run tests/database.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "start:api": "node dist/apps/api/server.js",
    "start:web": "node dist/apps/web/server.js"
  },
  "dependencies": { "@prisma/client": "6.14.0" },
  "devDependencies": { "@eslint/js": "9.33.0", "@types/node": "22.17.1", "eslint": "9.33.0", "prisma": "6.14.0", "typescript": "5.9.2", "typescript-eslint": "8.39.1", "vitest": "3.2.4" }
}
